<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.andykim.congress-fec-refresh</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/andykim/Developer/congress-fec-tracker/scripts/local_fec_refresh.sh</string>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/andykim/Library/Logs/congress-fec-refresh.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/andykim/Library/Logs/congress-fec-refresh.launchd.log</string>
    <!-- Sundays 18:00 local. If the Mac is asleep then, launchd runs it once on wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>18</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
</dict>
</plist>
